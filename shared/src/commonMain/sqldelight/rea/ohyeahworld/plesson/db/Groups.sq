-- CRUD: группы (справочник)
selectAllGroups:
SELECT * FROM groups ORDER BY group_name ASC;

searchGroups:
SELECT * FROM groups
WHERE group_name LIKE '%' || :query || '%'
ORDER BY group_name ASC
LIMIT 100;

upsertGroup:
INSERT OR REPLACE INTO groups(group_guid, group_name, faculty, program_type, course)
VALUES(:guid, :name, :faculty, :program_type, :course);

groupByName:
SELECT * FROM groups WHERE group_name = :name LIMIT 1;
